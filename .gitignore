# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.ipynb_checkpoints/

# Run outputs (regenerated by the notebooks). Under results/ only the
# metrics.json records are tracked; checkpoints, logs and figures are not,
# at results/<target>/ and at results/<target>/seedN/ alike.
/results/**/checkpoint.pkl
/results/**/log.txt
/results/**/stdout.log
/results/**/figures/
/results/**/seeds_done.txt
/results/sweep*.log
/results/sweep.pgid

# Data: downloaded files are fetched by redownload.sh; keep only the script
/data/*
!/data/redownload.sh

# Local tooling / scratch
.claude/
.codex/
.agents/
commit_message.txt

# Ablation experiments (not part of this repo). Imports from
# progressive_is_tempering/ are fine; figures and results are copied out by
# hand for the paper, so nothing under here is tracked.
/ablations/

# Personal workspace (not part of this repo): studying/ holds experimental
# implementations and idea prototypes; references/ holds reference material
# for things to implement.
/studying/
/references/
